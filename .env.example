# ============================================================
# MAILY — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in your values.
# Lines starting with # are comments.
# Variables marked [REQUIRED] will break the app if missing.
# Variables marked [OPTIONAL] enable extra features when set.
# ============================================================


# ─────────────────────────────────────────────
# NEXTAUTH / APP URL
# ─────────────────────────────────────────────

# [REQUIRED] The public URL of your deployed app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# [REQUIRED] A random 32-char secret — run: openssl rand -base64 32
NEXTAUTH_SECRET=

# Alias used by Auth.js v5 (same value as NEXTAUTH_SECRET)
AUTH_SECRET=

# [OPTIONAL] Overrides the base URL used for internal API calls / HTTP-Referer
HOST=http://localhost:3000

# [OPTIONAL] Public-facing app URL (used in redirects, sharing links)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─────────────────────────────────────────────
# GOOGLE OAUTH (Gmail, Calendar, Tasks)
# ─────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials

# [REQUIRED] Your Google OAuth 2.0 client ID
GOOGLE_CLIENT_ID=

# [REQUIRED] Your Google OAuth 2.0 client secret
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] Set to 'true' to enforce Google Data Policy compliance mode
# (disables certain data-enrichment features)
GOOGLE_DATA_POLICY_COMPLIANCE=false


# ─────────────────────────────────────────────
# SUPABASE (Database)
# ─────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard -> Project Settings -> API

# [REQUIRED] Your Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [REQUIRED] Supabase anonymous/public key (safe to expose in browser)
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [REQUIRED] Supabase service role key — server-only, never expose to client!
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────
# OPENROUTER AI (Primary LLM provider)
# ─────────────────────────────────────────────
# Get keys at: https://openrouter.ai/keys
# Up to 5 keys are supported for load-balancing / rate-limit fallback.

# [REQUIRED] Primary OpenRouter API key
OPENROUTER_API_KEY=

# [OPTIONAL] Additional OpenRouter API keys (fallback / load balancing)
OPENROUTER_API_KEY2=
OPENROUTER_API_KEY3=
OPENROUTER_API_KEY4=
OPENROUTER_API_KEY5=

# [OPTIONAL] Override the default AI model used for email writing
# Example: google/gemini-flash-1.5, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=

# [OPTIONAL] Comma-separated list of premium paid models for Boult
# Example: anthropic/claude-opus-4,google/gemini-2.5-pro
BOULT_PREMIUM_MODELS=

# [OPTIONAL] Set to 'true' to disable paid model fallback (cost control)
DISABLE_PAID_FALLBACK=false


# ─────────────────────────────────────────────
# ELEVENLABS (AI Voice / Conversational Agent)
# ─────────────────────────────────────────────
# Get keys at: https://elevenlabs.io/app/settings/api-keys

# [OPTIONAL] ElevenLabs API key — enables voice features
ELEVENLABS_API_KEY=

# [OPTIONAL] ElevenLabs Conversational AI agent ID
ELEVENLABS_AGENT_ID=


# ─────────────────────────────────────────────
# RESEND (Transactional Email)
# ─────────────────────────────────────────────
# Get key at: https://resend.com/api-keys

# [REQUIRED for email sending] Resend API key
RESEND_API_KEY=

# [OPTIONAL] The "from" address used for outgoing emails
# Default: Boult AI <boult@maily.cfd>
RESEND_FROM_EMAIL=Boult AI <boult@maily.cfd>


# ─────────────────────────────────────────────
# POLAR (Subscription & Billing)
# ─────────────────────────────────────────────
# Get keys at: https://polar.sh/dashboard -> Settings -> Developers

# [REQUIRED for billing] Polar API access token
POLAR_ACCESS_TOKEN=
# Alias (legacy): POLAR_API_KEY=

# [REQUIRED for webhooks] Polar webhook secret — verify incoming events
POLAR_WEBHOOK_SECRET=

# [REQUIRED for billing] Your Polar organization ID
POLAR_ORGANIZATION_ID=

# [OPTIONAL] Admin secret to manually activate subscriptions via API
SUBSCRIPTION_ACTIVATION_ADMIN_SECRET=


# ─────────────────────────────────────────────
# COMPOSIO (Gmail / Google Meet / Google Calendar via Composio)
# ─────────────────────────────────────────────
# Sign up at: https://composio.dev

# [OPTIONAL] Composio API key — enables Composio-based integrations
COMPOSIO_API_KEY=

# [OPTIONAL] Composio Auth Config ID for Gmail connector
COMPOSIO_GMAIL_AUTH_CONFIG_ID=

# [OPTIONAL] Composio Auth Config ID for Google Meet connector
COMPOSIO_MEET_AUTH_CONFIG_ID=

# [OPTIONAL] Composio Auth Config ID for Google Calendar connector
COMPOSIO_GCAL_AUTH_CONFIG_ID=

# [OPTIONAL] Webhook secret for validating incoming Composio events
COMPOSIO_WEBHOOK_SECRET=

# [OPTIONAL] Set to '1' to enable Composio-based Gmail onboarding flow
NEXT_PUBLIC_COMPOSIO_GMAIL=0

# [OPTIONAL] Set to '1' to enable Composio tool usage in Boult agent
COMPOSIO_TOOLS=0

# [OPTIONAL] Set to '1' to enable Composio OAuth login
COMPOSIO_LOGIN=0


# ─────────────────────────────────────────────
# NOTION INTEGRATION
# ─────────────────────────────────────────────
# Create integration at: https://www.notion.so/my-integrations

# [OPTIONAL] Notion OAuth client ID (for user-level OAuth connections)
NOTION_CLIENT_ID=
NEXT_PUBLIC_NOTION_CLIENT_ID=

# [OPTIONAL] Notion OAuth client secret
NOTION_CLIENT_SECRET=

# [OPTIONAL] Notion integration token (for server-to-server access)
NOTION_INTEGRATION_TOKEN=

# [OPTIONAL] Default Notion database ID to use when none is specified
NOTION_DEFAULT_DATABASE_ID=


# ─────────────────────────────────────────────
# CAL.COM INTEGRATION (Scheduling)
# ─────────────────────────────────────────────
# Get API key at: https://cal.com/settings/developer/api-keys

# [OPTIONAL] Shared Cal.com API key used as a server-side fallback
CAL_API_KEY=
CALCOM_API_KEY=

# [OPTIONAL] Cal.com OAuth client ID (for user-level OAuth flows)
CAL_COM_CLIENT_ID=

# [OPTIONAL] Cal.com OAuth client secret
CAL_COM_CLIENT_SECRET=

# [OPTIONAL] Cal.com username for shared calendar slot lookups
CAL_COM_USERNAME=

# [OPTIONAL] Set to 'true' to allow Boult to use the shared CAL_API_KEY
CAL_ALLOW_SHARED_KEY=false


# ─────────────────────────────────────────────
# SUPERMEMORY / DATAFAST (Boult AI Memory)
# ─────────────────────────────────────────────

# [OPTIONAL] Supermemory API key — enables long-term memory for Boult
# Get key at: https://app.supermemory.ai
SUPERMEMORY_API_KEY=

# [OPTIONAL] Datafast API key — alternative memory provider
DATAFAST_API_KEY=


# ─────────────────────────────────────────────
# WEB SEARCH (Boult Agent Tools)
# ─────────────────────────────────────────────

# [OPTIONAL] Serper API key — enables Google Search in Boult
# Get key at: https://serper.dev
SERPER_API_KEY=

# [OPTIONAL] Brave Search API key — alternative web search provider
# Get key at: https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=


# ─────────────────────────────────────────────
# POSTHOG (Analytics)
# ─────────────────────────────────────────────
# Get keys at: https://app.posthog.com/project/settings

# [OPTIONAL] PostHog project API key
NEXT_PUBLIC_POSTHOG_KEY=

# [OPTIONAL] PostHog host (default: https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ─────────────────────────────────────────────
# ENCRYPTION
# ─────────────────────────────────────────────

# [REQUIRED] Secret used for AES-256 encryption of stored tokens & emails
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=


# ─────────────────────────────────────────────
# CRON JOB SECRET
# ─────────────────────────────────────────────

# [OPTIONAL] Bearer token to authorize internal cron API routes
# Should be a long random string
CRON_SECRET=


# ─────────────────────────────────────────────
# BOULT AGENT — FEATURE FLAGS
# ─────────────────────────────────────────────
# All flags default to true (enabled) when not set.
# Set to 'false' or '0' to disable a specific feature.

BOULT_OPERATOR_RUNTIME_V2=true
BOULT_CANVAS_ACTIONS_V2=true
BOULT_EXECUTION_GATEWAY_V1=true
BOULT_PLAN_MODE_V2=true
BOULT_FREE_ROUTER_V2=true
BOULT_PLAN_ENGINE=true
BOULT_NOTION_ADAPTER=true
BOULT_GOOGLE_TASKS=true
BOULT_SEARCH_TRANSPARENCY=true
BOULT_AGENT_LOOP_V1=true

# [OPTIONAL] Set to 'true' to enable the multi-model committee mode
BOULT_USE_COMMITTEE=false

# [OPTIONAL] Set to 'true' to run the Boult agent in sandbox/read-only mode
BOULT_AGENT_SANDBOX=false
